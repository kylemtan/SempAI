ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
KROGER_CLIENT_ID=your_kroger_client_id_here
KROGER_CLIENT_SECRET=your_kroger_client_secret_here
PORT=3001

# Visiting the app at /<this value> (e.g. https://yourapp.com/your-code) or
# with ?access=<this value> raises the daily AI request limit to 10 (from 2)
# — share the link with family/friends.
FULL_ACCESS_CODE=your_shared_passphrase_here
# Long random string used only to sign the access cookie server-side — never
# shared with anyone. Generate with: openssl rand -hex 32
COOKIE_SIGNING_SECRET=your_random_signing_secret_here
